      "title": "Modo Operacional da Central",
      "type": "stat",
      "targets": [
        {
          "datasource": {
            "type": "influxdb"
          },
          "query": "from(bucket: \"armazem_telemetria\")\n  |> range(start: -15m)\n  |> filter(fn: (r) => r[\"_measurement\"] == \"security_state\")\n  |> filter(fn: (r) => r[\"_field\"] == \"armed\" or r[\"_field\"] == \"alarm\")\n  |> pivot(rowKey:[\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({\n      _time: r._time,\n      _value: if r.alarm then 2 else if r.armed then 1 else 0\n  }))\n  |> last()",
          "refId": "A"
